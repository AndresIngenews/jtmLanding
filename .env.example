# Conexión MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mtslanding_bd

# Duración de la sesión del administrador (horas)
SESSION_TTL_HOURS=12

# Carpeta donde se guardan las imágenes subidas desde el admin
UPLOADS_DIR=storage/uploads
# Tamaño máximo de imagen (MB)
UPLOAD_MAX_MB=8
